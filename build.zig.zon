.{
    .name = .nanolight,
    .version = "0.1.0",
    .fingerprint = 0xe1facf60a4c2480c,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // nanoui 0.10.0 (justrach/nanoui@7ef0fe75), patched: an idle panel
        // wakes its display link instead of slowing it, so a key's frame is
        // never covered by an older one (vendor/nanoui/src/ui/surface.zig).
        .nanoui = .{ .path = "vendor/nanoui" },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "vendor", "macos", "raycast/dist", "LICENSE" },
}
